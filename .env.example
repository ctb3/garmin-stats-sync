# Token the phone app sends in the X-Auth-Token header. Required.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INGEST_TOKEN=

# Garmin Connect account. OPTIONAL - leave blank and log in through the
# /login page instead, so no password is ever stored. Tokens last about a
# year; you will be prompted again only when they expire.
GARMIN_EMAIL=
GARMIN_PASSWORD=

# Local timezone - weigh-ins are recorded against the local date
LOCAL_TZ=America/New_York

# How often the loop runs anyway. A weigh-in arriving over HTTP wakes the loop
# immediately, so this is a floor rather than the only trigger.
SYNC_INTERVAL_SECONDS=1800

# On a cold start (no state file), only sync weigh-ins from the last N days
COLD_START_DAYS=7

# How long an undelivered weigh-in stays in the spool before being dropped
INBOX_RETENTION_DAYS=30

# Shown on the status page. Optional.
PUBLIC_URL=https://garmin-sync.ironlan.ct3.net

# Set to 1 to log what would be uploaded without touching Garmin
DRY_RUN=
