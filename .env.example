# VeSync account (the one the scale is paired to)
VESYNC_EMAIL=you@example.com
VESYNC_PASSWORD=changeme

# Garmin Connect account
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=changeme

# Local timezone - weigh-ins are recorded against the local date
LOCAL_TZ=America/New_York

# How often the loop checks VeSync, in seconds
SYNC_INTERVAL_SECONDS=1800

# On a cold start (no state file), only sync weigh-ins from the last N days
COLD_START_DAYS=7

# Set to 1 to log what would be uploaded without touching Garmin
DRY_RUN=
